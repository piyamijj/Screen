<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.piyami.screen.eski" android:versionCode="4" android:versionName="1.2.1">
    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="22" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <application android:label="Screen Eski" android:icon="@drawable/icon" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:allowBackup="false">
        <activity android:name="com.piyami.screen.MainActivity" android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
